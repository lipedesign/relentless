{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relentless project config",
  "type": "object",
  "required": [
    "decider",
    "merge",
    "workers"
  ],
  "properties": {
    "decider": {
      "type": "object",
      "required": [
        "name",
        "github"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name used in authorship markers"
        },
        "github": {
          "type": "string",
          "description": "GitHub login to assign when human:pending"
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "github": {
            "type": "string"
          }
        },
        "required": [
          "github"
        ]
      },
      "description": "Named workers; assignee while state:in-progress"
    },
    "merge": {
      "type": "object",
      "required": [
        "default"
      ],
      "properties": {
        "default": {
          "enum": [
            "auto",
            "human"
          ]
        },
        "allow_issue_override": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "rulesets": {
      "type": "object",
      "properties": {
        "apply": {
          "type": "boolean",
          "default": false,
          "description": "Opt-in; fail soft if API denies"
        }
      }
    },
    "milestones": {
      "type": "object",
      "properties": {
        "require_outcome_section": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "stack": {
      "type": "string",
      "description": "Detected stack: node|python|go|rust|unknown"
    },
    "package_manager": {
      "type": [
        "string",
        "null"
      ],
      "description": "npm|pnpm|yarn|bun when stack=node"
    },
    "checks": {
      "type": "object",
      "properties": {
        "install": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "typecheck": {
          "type": "string"
        },
        "test": {
          "type": "string",
          "description": "Project test command (also written into relentless-ci.yml). stop-gate.sh runs this before a turn may end. Empty falls back to npm test when package.json scripts.test is set; no command skips that gate."
        },
        "build": {
          "type": "string"
        }
      },
      "description": "Commands Relentless wrote into relentless-ci.yml"
    }
  }
}
